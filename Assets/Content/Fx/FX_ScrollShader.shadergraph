        },
        {
            "m_Id": "00d92c1e37c14a35bd71623331b81eb4"
        },
        {
            "m_Id": "133557647dea4bcfbc52128c9b1db1ce"
        },
        {
            "m_Id": "9925c294794e4e5d88e394a1921855d7"
        },
        {
            "m_Id": "62d936bfa5e94fb5b70cab339d5ef5a5"
        },
        {
            "m_Id": "2f44a969b9c443cd870ace7f3695bdd2"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "GradientMask",
    "m_FunctionSource": "f8fac9e9843c84ee692ea387fdfec136",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "float left = max(0.0, (1.0 - UV.x) + Offset.r);\nleft = pow(left, Power.r);\nleft = saturate(left);\n\nfloat right = max(0.0, UV.x + Offset.g);\nright = pow(right, Power.g);\nright = saturate(right);\n\nfloat up = max(0.0, UV.y + Offset.b);\nup = pow(up, Power.b);\nup = saturate(up);\n\nfloat down = max(0.0, (1.0 - UV.y) + Offset.a);\ndown = pow(down, Power.a);\ndown = saturate(down);\n\nHorizontal = left * right * 4.0 * Multiply;\nVertical = up * down * 4.0 * Multiply;\nGeneral = Horizontal * Vertical;"
}

