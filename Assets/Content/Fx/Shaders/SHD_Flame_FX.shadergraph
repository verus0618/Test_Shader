{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "191a02acd6384edf95d2a0dc8b2360fd",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "FlameNoiseAdjustment (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -8119.99951171875,
            "y": 1388.6663818359375,
            "width": 286.66650390625,
            "height": 239.9998779296875
        }
    },
    "m_Slots": [
        {
            "m_Id": "53aad8600358452ea1dd26a47184b0f2"
        },
        {
            "m_Id": "79ed160a93114b69b9e9681ed0071fc6"
        },
        {
            "m_Id": "5a3d1397aa0447eebd0211bf02800ed3"
        },
        {
            "m_Id": "75afa30a221c40fe9228acf858a46c81"
        },
        {
            "m_Id": "dc1128739c04477584bd147d33590ee9"
        },
        {
            "m_Id": "1929a3301765409dbf305a8776bbee79"
        },
        {
            "m_Id": "4eb0bfb5a3cb40cd93545b0924be60ea"
        },
        {
            "m_Id": "21192c1bfe884e0e9dce45e69adbaebe"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "FlameNoiseAdjustment",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "float2 tiling = TillingOffset.xy;\r\nfloat2 scroll = TillingOffset.zw;\r\nfloat2 tiledUV = UV * tiling + scroll * ScrollSpeed;\r\n\r\nfloat noiseR = SAMPLE_TEXTURE2D(NoiseTexture.tex, NoiseTexture.samplerstate, tiledUV).r;\r\n\r\nfloat invertedNoise = 1.0 - noiseR;\r\nfloat blended = lerp(invertedNoise, noiseR, Invert);\r\n\r\nfloat intensityScaled = MinMaxIntensity.z * blended;\r\n\r\nfloat smoothed = smoothstep(MinMaxIntensity.x, MinMaxIntensity.y, intensityScaled);\r\n\r\nfloat clamped = clamp(smoothed, 0.0, 1.0);\r\n\r\nOut = clamped * OnOff;"
}

