{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "437888823f2443f3a84126af85d26a71",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "FlameShapeAdjustment (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -6024.0,
            "y": 418.9999694824219,
            "width": 289.0,
            "height": 166.00003051757813
        }
    },
    "m_Slots": [
        {
            "m_Id": "91bbf7c0bd294030bc03790dca5160de"
        },
        {
            "m_Id": "f2f23bf95e634c69a130d8f17f084dca"
        },
        {
            "m_Id": "aad6fd2d7d204566b280619913d1edbc"
        },
        {
            "m_Id": "f02d16494a14483a83d6a7be64968b34"
        },
        {
            "m_Id": "4c0880b7e2d647c0b6163daf4359946d"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "FlameShapeAdjustment",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "float Brightness = Brightness_Contrast_Dissolve.x;\r\nfloat Contrast   = Brightness_Contrast_Dissolve.y;\r\nfloat Dissolve   = Brightness_Contrast_Dissolve.z;\r\n\r\nfloat dissolveRemap = -1.0 + Dissolve * 3.0;\r\n\r\nfloat dissolveDiff   = DissolveMask - dissolveRemap;\r\nfloat dissolveSmooth = smoothstep(0.0, 1.0, dissolveDiff);\r\nfloat dissolveSat    = saturate(dissolveSmooth);\r\n\r\nfloat shapeInput = dissolveSat * ShapeMask;\r\n\r\nfloat shapeMin = Shape_MinMax.x;\r\nfloat shapeMax = Shape_MinMax.y;\r\nfloat shapeRemap = (shapeInput - shapeMin) / (shapeMax - shapeMin);\r\n\r\nfloat clipped    = max(shapeRemap, 0.0);\r\nfloat powered    = pow(clipped, Contrast);\r\nfloat brightened = powered * Brightness;\r\n\r\nOut = saturate(brightened);"
}

