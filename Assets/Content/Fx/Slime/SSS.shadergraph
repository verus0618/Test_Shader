    "m_FunctionBody": "SSS = float3(0.0, 0.0, 0.0);\r\n\r\n#ifdef SHADERGRAPH_PREVIEW\r\n\r\nSSS = float3(0.0, 0.0, 0.0);\r\n\r\n#else\r\n\r\nfloat3 N = normalize(NormalWS);\r\nfloat3 V = normalize(ViewDirectionWS);\r\n\r\nInputData inputData = (InputData)0;\r\ninputData.positionWS = PositionWS;\r\ninputData.normalWS = N;\r\ninputData.viewDirectionWS = V;\r\ninputData.normalizedScreenSpaceUV = ScreenUV;\r\n\r\n\r\n// MAIN DIRECTIONAL LIGHT\r\n\r\nLight mainLight = GetMainLight();\r\n\r\nfloat3 mainTransmissionDir =\r\n    -normalize(\r\n        N * Normal_Influence +\r\n        mainLight.direction\r\n    );\r\n\r\nfloat mainTransmission =\r\n    pow(\r\n        saturate(\r\n            dot(\r\n                mainTransmissionDir,\r\n                V\r\n            )\r\n        ),\r\n        SSS_Power\r\n    );\r\n\r\nSSS +=\r\n    mainLight.color *\r\n    mainTransmission *\r\n    MainLight_Intensity;\r\n\r\n\r\n// ADDITIONAL LIGHTS\r\n\r\n#if defined(_ADDITIONAL_LIGHTS)\r\n\r\n\r\n// ADDITIONAL DIRECTIONAL LIGHTS IN FORWARD+\r\n\r\n#if USE_FORWARD_PLUS\r\n\r\nUNITY_LOOP for (\r\n    uint lightIndex = 0u;\r\n    lightIndex < min(\r\n        URP_FP_DIRECTIONAL_LIGHTS_COUNT,\r\n        MAX_VISIBLE_LIGHTS\r\n    );\r\n    ++lightIndex\r\n)\r\n{\r\n    Light light = GetAdditionalLight(\r\n        lightIndex,\r\n        PositionWS,\r\n        half4(1, 1, 1, 1)\r\n    );\r\n\r\n    float3 transmissionDir =\r\n        -normalize(\r\n            N * Normal_Influence +\r\n            light.direction\r\n        );\r\n\r\n    float transmission =\r\n        pow(\r\n            saturate(\r\n                dot(\r\n                    transmissionDir,\r\n                    V\r\n                )\r\n            ),\r\n            SSS_Power\r\n        );\r\n\r\n    SSS +=\r\n        light.color *\r\n        transmission *\r\n        light.distanceAttenuation *\r\n        AdditionalLights_Intensity;\r\n}\r\n\r\n#endif\r\n\r\n\r\n// POINT / SPOT LIGHTS\r\n\r\nuint pixelLightCount = GetAdditionalLightsCount();\r\n\r\nLIGHT_LOOP_BEGIN(pixelLightCount)\r\n\r\n    Light light = GetAdditionalLight(\r\n        lightIndex,\r\n        PositionWS,\r\n        half4(1, 1, 1, 1)\r\n    );\r\n\r\n    float3 transmissionDir =\r\n        -normalize(\r\n            N * Normal_Influence +\r\n            light.direction\r\n        );\r\n\r\n    float transmission =\r\n        pow(\r\n            saturate(\r\n                dot(\r\n                    transmissionDir,\r\n                    V\r\n                )\r\n            ),\r\n            SSS_Power\r\n        );\r\n\r\n    SSS +=\r\n        light.color *\r\n        transmission *\r\n        light.distanceAttenuation *\r\n        AdditionalLights_Intensity;\r\n\r\nLIGHT_LOOP_END\r\n\r\n\r\n#endif\r\n\r\n#endif"
}

