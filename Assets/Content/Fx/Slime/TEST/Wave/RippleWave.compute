// RippleWave.compute
// Wave simulation running on the adjacency graph of welded surface vertices.
// Three kernels:
//   UpdateMask       — smooths the raw occupancy signal (from the CPU-side
//                       collider test) and records the entry/exit times used
//                       for the periodic pulse's phase and the fade in/out
//                       envelope.
//   UpdateWave       — the wave equation itself (decay governed solely by
//                       Waves Max Distance / Speed, never by Fade Out), plus
//                       the enveloped periodic pulse injection (Fade In/Out
//                       govern only how long the source keeps emitting).
//   SmoothForDisplay — optional cosmetic neighbor-blend for rendering only.

#pragma kernel UpdateMask
#pragma kernel UpdateWave
#pragma kernel SmoothForDisplay
#pragma kernel ExtractReleaseBoundary
#pragma kernel DilateRelease
#pragma kernel InjectRelease
#pragma kernel BlurRelease

// ---- Shared buffers (size = weldedVertexCount) ----
RWStructuredBuffer<float> _RawOccupancy;      // 0/1, written from CPU every frame (collider test)
RWStructuredBuffer<float> _Mask;              // smoothed 0..1 mask; sole remaining job is seeding the distance field

// The emission source, written by the CPU on release steps only: the entire
// contact silhouette at one instant, already softened by BlurRelease. Scaled
// by _ReleaseScale, which is 1 on exactly the step consuming a release and 0
// on every other step. Emission is therefore a discrete stamp of a whole
// shape rather than a rate integrated along a moving contact — see the
// _releaseMaskA comment on the C# side for why a swept source cannot work.
StructuredBuffer<float> _ReleaseMask;

// Ping-pong pair for the release-softening blur (Wave Softening).
StructuredBuffer<float> _BlurSource;
RWStructuredBuffer<float> _BlurTarget;

RWStructuredBuffer<float> _HCurrent;   // wave field, current frame (read-only in this dispatch)
RWStructuredBuffer<float> _HPrevious;  // wave field, previous frame (read-only)
RWStructuredBuffer<float> _HNext;      // output buffer for the new frame (write-only)
RWStructuredBuffer<float> _HDisplay;   // cosmetic, smoothed copy of _HCurrent the renderer actually reads

// ---- Adjacency (CSR) ----
StructuredBuffer<int> _NeighborOffsets;     // length weldedVertexCount + 1
StructuredBuffer<int> _NeighborIndices;     // flat neighbor index list
StructuredBuffer<float> _NeighborDistances; // parallel to _NeighborIndices, world/local-space edge length

// ---- Parameters ----
uint _WeldedVertexCount;
float _DeltaTime;
float _Time;

float _MaskSmoothRate; // occupancy -> mask smoothing rate (1/sec), derived from Wave Softening
float _WaveSpeed2;     // c^2 in the wave equation, kept within a numerically stable range internally
float _Damping;        // per-step decay multiplier, derived from Waves Max Distance / Speed (a ripple's natural lifetime)
float _PulseStrength;  // overall amplitude of a released ring (Wave Amplitude)
float _ReleaseScale;   // 1 only on the step that consumes a release, 0 otherwise
float _DisplaySmoothing;  // 0 = show the raw simulated value, 1 = fully neighbor-averaged (cosmetic only)

[numthreads(64, 1, 1)]
void UpdateMask(uint3 id : SV_DispatchThreadID)
{
    uint i = id.x;
    if (i >= _WeldedVertexCount) return;

    float raw = _RawOccupancy[i];

    // Entry/exit edge detection used to live here, per vertex. It now lives
    // on the CPU, per contact EVENT, because per-vertex detection is exactly
    // what made a fast pass break: each vertex started its own ripple at its
    // own moment, dragging the source across the surface faster than the
    // wave could travel. The mask's only remaining job is to seed the
    // geodesic distance field in UpdateWave with a slightly softened
    // silhouette boundary.
    float t = saturate(_MaskSmoothRate * _DeltaTime);
    _Mask[i] = lerp(_Mask[i], raw, t);
}

[numthreads(64, 1, 1)]
void UpdateWave(uint3 id : SV_DispatchThreadID)
{
    uint i = id.x;
    if (i >= _WeldedVertexCount) return;

    // ---- Distance-weighted graph Laplacian ----
    // Plain unweighted neighbor averaging makes perceived wave speed depend
    // on local vertex density (dense areas "slow down" the wave relative to
    // sparse ones). Weighting by inverse squared edge length keeps closer
    // neighbors dominant regardless of local tessellation, so a given
    // _WaveSpeed2 behaves consistently across the whole mesh.
    int start = _NeighborOffsets[i];
    int end = _NeighborOffsets[i + 1];

    float weightedSum = 0.0;
    float weightTotal = 0.0;
    for (int n = start; n < end; n++)
    {
        float dist = _NeighborDistances[n];
        float weight = 1.0 / max(dist * dist, 1e-6);
        weightedSum += _HCurrent[_NeighborIndices[n]] * weight;
        weightTotal += weight;
    }
    float neighborAverage = weightTotal > 0.0 ? weightedSum / weightTotal : _HCurrent[i];

    float h = _HCurrent[i];
    float hPrev = _HPrevious[i];

    // ---- Classic leapfrog wave equation ----
    // Reach is governed ENTIRELY by _Damping now, which is derived from
    // Wave Max Distance / effective Lifetime on the C# side: a ring decays
    // to 5% of its birth amplitude by the time it has had exactly enough
    // time to travel Max Distance at its own propagation speed. That is the
    // same reach guarantee a separate spatial cutoff was trying to enforce,
    // but as a plain per-step multiply with no spatial gradient anywhere in
    // the field — which means there is nothing here that can reflect. A
    // spatial cutoff (an earlier version of this file had one, via a
    // geodesic distance-from-source field relaxed every step) was removed:
    // it required its own relaxation kernel and cold-start handling, and it
    // caused real bugs twice — a flash-then-die on first contact when the
    // field hadn't relaxed yet, and a reflected "wave reversing near the
    // end" from the field's edge acting as a soft wall. None of that
    // complexity was buying anything that time-based damping doesn't
    // already give for free.
    float hNew = 2.0 * h - hPrev + _WaveSpeed2 * (neighborAverage - h);
    hNew *= _Damping;

    // Emission no longer happens here — see InjectRelease below for why.
    _HNext[i] = hNew;
}

// ---- Release injection ----
// Adds a newly released silhouette into the wave field with correctly zero
// initial velocity, dispatched BEFORE UpdateWave on a release step (and
// skipped entirely otherwise, since _ReleaseScale is 0).
//
// The leapfrog integrator above computes hNew = 2h - hPrev + c^2*(avg - h).
// That formula assumes h and hPrev already represent a physically consistent
// state one timestep apart. Adding the release amplitude to the OUTPUT of a
// single step (as an earlier version of this file did) leaves hPrev at its
// old, lower value, which the very next step reads as "this vertex moved a
// large distance in one timestep" — a spurious velocity of roughly
// amplitude / dt baked in by the seeding itself, not by the wave equation.
// Leapfrog then amplifies that spurious velocity for several steps before
// damping catches up, which is exactly the single sharp flash on release:
// numerically it overshot the injected amplitude by roughly 6x here before
// settling, an artifact of how the pulse was seeded, not the wave itself.
//
// Adding the same amplitude to BOTH h and hPrev cancels that: the implied
// velocity (h - hPrev) / dt is unchanged by an equal shift to both, so the
// ring is seeded at rest and only starts moving because of its own spatial
// curvature (the Laplacian term), which is what should be driving it.
[numthreads(64, 1, 1)]
void InjectRelease(uint3 id : SV_DispatchThreadID)
{
    uint i = id.x;
    if (i >= _WeldedVertexCount) return;

    float amount = _ReleaseMask[i] * _PulseStrength * _ReleaseScale;
    _HCurrent[i] += amount;
    _HPrevious[i] += amount;
}

// ---- Cosmetic smoothing pass, decoupled from physics ----
// The wave equation above is the source of truth for propagation speed,
// interference and decay — none of that runs here. This kernel only
// decides what the *renderer* sees: it blends each vertex's simulated
// value with a distance-weighted average of its neighbors, purely to
// soften the visible steps between vertices on a coarse mesh. Written
// into _HDisplay, the one buffer the renderer actually reads, so the
// simulation state itself (_HCurrent/_HPrevious/_HNext) stays untouched
// and wave speed/timing are unaffected regardless of this setting.
[numthreads(64, 1, 1)]
void SmoothForDisplay(uint3 id : SV_DispatchThreadID)
{
    uint i = id.x;
    if (i >= _WeldedVertexCount) return;

    float h = _HCurrent[i];

    if (_DisplaySmoothing <= 0.0)
    {
        _HDisplay[i] = h;
        return;
    }

    int start = _NeighborOffsets[i];
    int end = _NeighborOffsets[i + 1];

    float weightedSum = 0.0;
    float weightTotal = 0.0;
    for (int n = start; n < end; n++)
    {
        float dist = _NeighborDistances[n];
        float weight = 1.0 / max(dist * dist, 1e-6);
        weightedSum += _HCurrent[_NeighborIndices[n]] * weight;
        weightTotal += weight;
    }
    float neighborAverage = weightTotal > 0.0 ? weightedSum / weightTotal : h;

    _HDisplay[i] = lerp(h, neighborAverage, _DisplaySmoothing);
}

// ---- Release softening (Wave Softening) ----
// Distance-weighted neighbor blur over the adjacency graph, run a few times
// on the release buffer before it is emitted. Blurring the SOURCE rather
// than the field means softening changes how soft the ring's edge is
// without touching propagation, decay, or timing in any way. Dispatched
// only on release steps, so its cost is negligible.
[numthreads(64, 1, 1)]
void BlurRelease(uint3 id : SV_DispatchThreadID)
{
    uint i = id.x;
    if (i >= _WeldedVertexCount) return;

    int start = _NeighborOffsets[i];
    int end = _NeighborOffsets[i + 1];

    float weightedSum = 0.0;
    float weightTotal = 0.0;
    for (int n = start; n < end; n++)
    {
        float dist = _NeighborDistances[n];
        float weight = 1.0 / max(dist * dist, 1e-6);
        weightedSum += _BlurSource[_NeighborIndices[n]] * weight;
        weightTotal += weight;
    }

    float self = _BlurSource[i];
    float neighborAverage = weightTotal > 0.0 ? weightedSum / weightTotal : self;
    _BlurTarget[i] = lerp(self, neighborAverage, 0.5);
}


// ---- Silhouette outline extraction ----
// A filled silhouette is not a wave source. The wave equation moves energy
// through the Laplacian (neighborAverage - h), and inside a uniform patch
// every neighbor equals the vertex itself, so the Laplacian is exactly zero
// and the patch simply sits there decaying in place — a solid flash in the
// shape of the occluder, which is precisely the fast-pass symptom. Curvature
// exists only at the patch BOUNDARY, so that is what must be emitted: the
// outline of the intersection, one vertex wide here and widened below.
[numthreads(64, 1, 1)]
void ExtractReleaseBoundary(uint3 id : SV_DispatchThreadID)
{
    uint i = id.x;
    if (i >= _WeldedVertexCount) return;

    float self = _BlurSource[i];
    if (self <= 0.0) { _BlurTarget[i] = 0.0; return; }

    int start = _NeighborOffsets[i];
    int end = _NeighborOffsets[i + 1];

    float minNeighbor = self;
    for (int n = start; n < end; n++)
    {
        minNeighbor = min(minNeighbor, _BlurSource[_NeighborIndices[n]]);
    }

    // Zero deep inside the patch (all neighbors equally occupied), full
    // strength where the patch meets open surface. Using the difference
    // rather than a hard test keeps this correct when two events of
    // different amplitude touch.
    _BlurTarget[i] = max(0.0, self - minNeighbor);
}

// ---- Outline widening ----
// Dilation (max over neighbors) rather than blurring, because a blur would
// spread the one-vertex outline while dividing its amplitude down with every
// pass, so ring strength would depend on Wave Softening. Max propagation
// widens the ring while preserving its height exactly.
[numthreads(64, 1, 1)]
void DilateRelease(uint3 id : SV_DispatchThreadID)
{
    uint i = id.x;
    if (i >= _WeldedVertexCount) return;

    int start = _NeighborOffsets[i];
    int end = _NeighborOffsets[i + 1];

    float widest = _BlurSource[i];
    for (int n = start; n < end; n++)
    {
        widest = max(widest, _BlurSource[_NeighborIndices[n]]);
    }
    _BlurTarget[i] = widest;
}
