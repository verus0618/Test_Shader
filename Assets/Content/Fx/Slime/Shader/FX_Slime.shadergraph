    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "#ifdef SHADERGRAPH_PREVIEW\r\n    Emission = 0;\r\n#else\r\n    Light light = GetMainLight();\r\n\r\n    float NdotL = saturate(dot(normalize(Normal), light.direction));\r\n    float darkness = 1.0 - NdotL;\r\n\r\n    float3 diffuse = BaseColor * (1.0 - Metallic);\r\n    Emission = diffuse * light.color * darkness * Strength;\r\n#endif"
}

